rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Survey responses collection
    match /survey_responses/{responseId} {
      // Allow public creation of responses with basic schema validation
      allow create: if request.resource.data.keys().hasAll(['roleKey', 'role', 'exposure', 'answers'])
                    && request.resource.data.answers is map;
      
      // Only authenticated users (admins) can view survey submissions
      allow read: if request.auth != null;
      
      // Never allow public or unauthorized modification or deletion
      allow update, delete: if request.auth != null;
    }

    // Default catch-all for any other collections: require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
